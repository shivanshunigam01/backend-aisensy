NODE_ENV=development
PORT=8787
RAZORPAY_API_PORT=8787

# Razorpay (server only)
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=xxxx

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DATABASE_NAME?retryWrites=true&w=majority

# Legacy admin token (fallback during migration)
ADMIN_PANEL_TOKEN=ZV-ADMIN-2026-DEMO

# Admin JWT auth
ADMIN_JWT_SECRET=change-me-to-a-long-random-string
ADMIN_SEED_EMAIL=admin@zentroverse.in
ADMIN_SEED_PASSWORD=Zentro@2026

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:8080,http://localhost:5173,https://zentroverse.com,https://www.zentroverse.com

# Cloudinary (optional — CMS media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=zentroverse

# --- ZentroFlow 2.0 ---
ZF_JWT_SECRET=change-me-zentroflow-jwt
ZF_SEED_EMAIL=flow@zentroverse.in
ZF_SEED_PASSWORD=ZentroFlow@2026

# Meta Lead Ads + CAPI (paste when ready)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_SYSTEM_USER_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# Reserved (WhatsApp / email / voice)
WHATSAPP_API_KEY=
WHATSAPP_API_URL=
EMAIL_PROVIDER=
VOICE_PROVIDER_API_KEY=
