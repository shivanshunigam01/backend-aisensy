NODE_ENV=development
PORT=8787
RAZORPAY_API_PORT=8787

# Razorpay (server only)
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=xxxx

# MongoDB Atlas — use Database > Connect > Drivers to copy your URI.
# Include database name before ? e.g. ...mongodb.net/mydb?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DATABASE_NAME?retryWrites=true&w=majority
