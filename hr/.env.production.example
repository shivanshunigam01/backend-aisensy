# Production API — copy into Render / Railway. Never commit real secrets.

NODE_ENV=production
PORT=4000
APP_NAME=PeopleFlow API
API_PREFIX=/api/v1
APP_URL=https://your-app.vercel.app
TRUST_PROXY=true

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/peopleflow?retryWrites=true&w=majority

# Comma-separated browser origins. Must match the Vercel URL (and custom domain).
CORS_ORIGIN=https://your-app.vercel.app

# Use none when the browser calls this origin directly from another site (Vercel -> API).
# Use lax when Next.js proxies /api to this service.
COOKIE_SAMESITE=none
COOKIE_DOMAIN=
ALLOW_PUBLIC_REGISTER=true

JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-plus-random-string
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=peopleflow
JWT_AUDIENCE=peopleflow-api

BCRYPT_SALT_ROUNDS=12
REFRESH_COOKIE_MAX_AGE_MS=604800000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=peopleflow
