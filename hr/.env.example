NODE_ENV=development
PORT=4000
APP_NAME=PeopleFlow API
API_PREFIX=/api/v1
APP_URL=http://localhost:3000
TRUST_PROXY=false

MONGODB_URI=mongodb://127.0.0.1:27017/peopleflow

CORS_ORIGIN=http://localhost:3000
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
ALLOW_PUBLIC_REGISTER=true
JSON_BODY_LIMIT=1mb

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=peopleflow
JWT_AUDIENCE=peopleflow-api

BCRYPT_SALT_ROUNDS=12
REFRESH_COOKIE_MAX_AGE_MS=604800000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=peopleflow

AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_INTERVIEW_PASSING_SCORE=70
AI_INTERVIEW_EXPIRY_HOURS=72

# Email (required to actually send; without these, emails are logged to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
