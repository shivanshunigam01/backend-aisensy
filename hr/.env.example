# PeopleFlow HR API (full reference package)
# Mounted copy of hr-module/hr-module-master/backend
#
# Integrated runtime for create-space uses: ../src/hr  →  /api/hr/*
# This package is the full PeopleFlow TypeScript API (recruitment suite, etc).
#
# Run standalone (optional):
#   npm install
#   copy .env.example → .env  (set MONGODB_URI, JWT secrets)
#   npm run dev          # http://localhost:4000/api/v1
#
# From parent backend folder:
#   npm run hr:install
#   npm run hr:dev

NODE_ENV=development
PORT=4000
APP_NAME=Zentroverse HR API
API_PREFIX=/api/v1
APP_URL=http://localhost:8080
TRUST_PROXY=false

MONGODB_URI=mongodb://127.0.0.1:27017/zentro_hr

CORS_ORIGIN=http://localhost:8080,http://localhost:5173
COOKIE_SAMESITE=lax
ALLOW_PUBLIC_REGISTER=true
JSON_BODY_LIMIT=1mb

JWT_ACCESS_SECRET=zentro-hr-access-secret-change-me-32chars
JWT_REFRESH_SECRET=zentro-hr-refresh-secret-change-me-32chars
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=zentroverse-hr
JWT_AUDIENCE=zentroverse-hr-api

BCRYPT_SALT_ROUNDS=12

AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_INTERVIEW_PASSING_SCORE=70
AI_INTERVIEW_EXPIRY_HOURS=72

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
